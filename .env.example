# Copiar a .env:  Copy-Item .env.example .env
# Deben coincidir con DB_* en backend/.env

# Rutas a los otros repos (relativas a esta carpeta)
BACKEND_PATH=../backend
FRONTEND_PATH=../frontend

# Puertos expuestos en tu máquina
BACKEND_PORT=8000
FRONTEND_PORT=5173
DB_EXTERNAL_PORT=3307

# MySQL 8.4 (solo para desarrollo local)
DB_DATABASE=proyecto_db
DB_USERNAME=equipo_user
DB_PASSWORD=equipo_password
DB_ROOT_PASSWORD=rootpassword
